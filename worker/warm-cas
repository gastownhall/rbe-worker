#!/usr/bin/env python3
"""warm-cas URL STORE DEADLINE [MAX_BYTES]

Warm a NativeLink 1.7.1 worker's local CAS before NativeLink starts, from
rbe-west's warm set: a read-only bundle of hot CAS blobs (toolchains, the Go
SDK, dependency archives) that the core's rbe-warmset timer selects from
trusted results (AC_OSS input trees) and publishes on R2. No pool VM can
write it.

URL       https://HOST[/PREFIX] serving current.json and chunks/SET/NN.tar.zst
STORE     the worker's store root: blobs go to STORE/content/d2, named as the
          filesystem store names them (<sha256>-<size>-0, mode 0444), staged
          in STORE/tmp/d2 (NativeLink prunes leftovers there at startup)
DEADLINE  epoch seconds: unfinished chunks are abandoned then, or at SIGTERM
          (blacksmith-worker.sh sends it once isolation is ready); every blob
          already renamed into place is complete and verified
MAX_BYTES stop after this many raw bytes of chunks (default 30e9)

Every blob is re-hashed (SHA-256) and size-checked against its name before
it is renamed into content/d2: a corrupt, truncated or substituted download
costs a cold blob, never a wrong input. Only regular tar members named
<64 hex>-<size> are read, and nothing is extracted by path, so links,
devices, absolute or '..' names are skipped. Prints one line
  rbe-warm: set=S status=ok|partial|timeout|error|off blobs=N bytes=N
            rejected=N skipped=N chunks=I/N wire=N wire_done=N seconds=S
and exits 0 unless misused (2): a failure costs the warm start, never the
worker. Needs python3, curl and zstd (all on the runner image).
"""
import hashlib, json, os, re, shutil, signal, subprocess, sys, tarfile, time, urllib.parse

NAME = re.compile(r"^([0-9a-f]{64})-([0-9]{1,15})$")
SET = re.compile(r"^[0-9a-f]{16,64}$")
CHUNK = re.compile(r"^([0-9a-f]{16,64})/[0-9]{2,4}\.tar\.zst$")
PARALLEL = int(os.environ.get("RBE_WARM_PARALLEL", "6"))
BLOB_MAX = 4 << 30  # no input blob is near this: a bigger member is junk
FREE_MARGIN = 20e9  # disk left for the actions this VM will run


def line(**kv):
    print("rbe-warm: " + " ".join(f"{k}={v}" for k, v in kv.items()), flush=True)


def curl(url, max_s):
    # IPv4 only: rbe-west's warm domain admits Blacksmith's IPv4 range alone
    # (infra tofu zone-waf.tf), and its edge also answers on IPv6.
    return ["curl", "-fsS", "--ipv4", "--proto", "=https,http", "--retry", "2", "--retry-delay", "1",
            "--max-time", str(max(1, int(max_s))), url]


def ingest_chunk(url, d2, tmpd, deadline, stats_fd):
    """In a child (its own process group): stream one chunk through zstd and
    tar, place each verified blob, report 'placed bytes rejected skipped'."""
    os.setpgid(0, 0)
    dl = subprocess.Popen(curl(url, deadline - time.time()), stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL)
    dz = subprocess.Popen(["zstd", "-dcq"], stdin=dl.stdout, stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL)
    dl.stdout.close()
    placed = nbytes = rejected = skipped = 0
    try:
        with tarfile.open(fileobj=dz.stdout, mode="r|") as tf:
            for m in tf:
                mm = NAME.match(m.name)
                if not m.isreg() or not mm or m.size != int(mm.group(2)) or m.size > BLOB_MAX:
                    skipped += 1
                    continue
                final = os.path.join(d2, m.name + "-0")
                if os.path.exists(final):
                    skipped += 1
                    continue
                tmp = os.path.join(tmpd, f"warm-{os.getpid()}-{placed + rejected}")
                src, h, got = tf.extractfile(m), hashlib.sha256(), 0
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                try:
                    while True:
                        piece = src.read(1 << 20)
                        if not piece:
                            break
                        h.update(piece)
                        got += len(piece)
                        os.write(fd, piece)
                    ok = got == m.size and h.hexdigest() == mm.group(1)
                    if ok:
                        os.fchmod(fd, 0o444)
                finally:
                    os.close(fd)
                if not ok:
                    rejected += 1
                    os.unlink(tmp)
                    continue
                os.rename(tmp, final)
                placed += 1
                nbytes += got
    except (tarfile.TarError, OSError, EOFError):
        rejected += 1  # a broken stream: what was placed before it stands
    finally:
        for p in (dz, dl):
            if p.poll() is None:
                p.kill()
            p.wait()
    os.write(stats_fd, f"{placed} {nbytes} {rejected} {skipped}\n".encode())
    os._exit(0)


def main(argv):
    if len(argv) not in (4, 5):
        print(__doc__, file=sys.stderr)
        return 2
    url, store, deadline = argv[1].rstrip("/"), argv[2], float(argv[3])
    cap = float(argv[4]) if len(argv) == 5 else 30e9
    u = urllib.parse.urlsplit(url)
    if u.scheme not in ("https", "http") or not u.netloc or u.query or u.fragment:
        print("warm-cas: URL must be https://host[/prefix]", file=sys.stderr)
        return 2
    try:
        os.setsid()  # a session of its own: blacksmith-worker.sh kills it whole if it overstays
    except OSError:
        pass
    stop = []
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))  # report what is placed, then exit
    t0 = time.time()
    if not (shutil.which("curl") and shutil.which("zstd")):
        line(set="-", status="error", reason="tools", seconds=0.0)
        return 0
    d2, tmpd = os.path.join(store, "content", "d2"), os.path.join(store, "tmp", "d2")
    os.makedirs(d2, exist_ok=True)
    os.makedirs(tmpd, exist_ok=True)
    try:
        man = json.loads(subprocess.run(curl(f"{url}/current.json", min(15, deadline - time.time())),
                                        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=True).stdout)
        sid, chunks = man["set"], man["chunks"]
        if man.get("v") != 1 or not isinstance(sid, str) or not SET.match(sid) or not isinstance(chunks, list):
            raise ValueError("manifest")
        todo, raw, wire = [], 0, 0
        for c in chunks:
            mc = CHUNK.match(str(c["name"]))
            if not mc or mc.group(1) != sid:
                raise ValueError("chunk name")
            if raw + int(c["raw_bytes"]) > cap:
                break
            todo.append(str(c["name"]))
            raw += int(c["raw_bytes"])
            wire += int(c["zbytes"])
    except (subprocess.CalledProcessError, ValueError, KeyError, TypeError) as e:
        line(set="-", status="error", reason=type(e).__name__, seconds=round(time.time() - t0, 1))
        return 0
    if shutil.disk_usage(d2).free < raw + FREE_MARGIN:
        line(set=sid, status="off", reason="disk", need=int(raw), seconds=round(time.time() - t0, 1))
        return 0
    rfd, wfd = os.pipe()
    running, done, i, wire_done = {}, 0, 0, 0
    zb = {n: int(c["zbytes"]) for n, c in zip(todo, chunks)}
    while (i < len(todo) or running) and time.time() < deadline and not stop:
        while i < len(todo) and len(running) < PARALLEL:
            pid = os.fork()
            if pid == 0:  # never returns into this loop, whatever happens
                try:
                    os.close(rfd)
                    ingest_chunk(f"{url}/chunks/{todo[i]}", d2, tmpd, deadline, wfd)
                finally:
                    os._exit(0)
            running[pid] = i
            i += 1
        pid, _ = os.waitpid(-1, os.WNOHANG)
        if pid:
            wire_done += zb[todo[running.pop(pid)]]
            done += 1
        else:
            time.sleep(0.05)
    timed_out = bool(running) or i < len(todo)
    for pid in running:  # deadline or SIGTERM: the chunk's curl, zstd and parser
        try:
            os.killpg(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    for pid in running:
        os.waitpid(pid, 0)
    os.close(wfd)
    rejected = skipped = 0
    with os.fdopen(rfd) as r:
        for ln in r:
            p = ln.split()
            rejected, skipped = rejected + int(p[2]), skipped + int(p[3])
    for f in os.listdir(tmpd):
        if f.startswith("warm-"):
            try:
                os.unlink(os.path.join(tmpd, f))
            except OSError:
                pass
    # Count what is in place (a killed chunk reported nothing, but its placed
    # blobs are complete and verified).
    placed = [e for e in os.scandir(d2) if e.name.endswith("-0") and NAME.match(e.name[:-2])]
    status = "timeout" if timed_out else "partial" if rejected else "ok"
    line(set=sid, status=status, blobs=len(placed), bytes=sum(e.stat().st_size for e in placed),
         rejected=rejected, skipped=skipped, chunks=f"{done}/{len(todo)}", wire=wire, wire_done=wire_done,
         seconds=round(time.time() - t0, 1))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
